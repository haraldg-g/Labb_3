<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">


    <Style TargetType="{x:Type Button}" x:Key="AnswerButtonStyle" >
        <Setter Property="Height" Value="80" />
        <Setter Property="Margin" Value="20,0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="BorderThickness" Value="1"/>
    </Style>
    
    <Style TargetType="{x:Type Image}" x:Key="AnswerImageStyle">
        <Setter Property="Height" Value="30" />
        <Setter Property="Width"  Value="30" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
    
    <Style  x:Key="AnswerImageStyleIndex0"
        TargetType="{x:Type Image}"
        BasedOn="{StaticResource AnswerImageStyle}">
        <Style.Triggers>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding HasAnswered}" Value="True"/>
                    <Condition Binding="{Binding CorrectAnswerIndex}" Value="0"/>
                </MultiDataTrigger.Conditions>

                <Setter Property="Source" Value="/Images/Correct.png"/>
                <Setter Property="Visibility" Value="Visible"/>
            </MultiDataTrigger>

            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding HasAnswered}" Value="True"/>
                    <Condition Binding="{Binding SelectedAnswerIndex}" Value="0"/>
                    <Condition Binding="{Binding IsAnswerCorrect}" Value="False"/>
                </MultiDataTrigger.Conditions>

                <Setter Property="Source" Value="/Images/Incorrect.png"/>
                <Setter Property="Visibility" Value="Visible"/>
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>
    
