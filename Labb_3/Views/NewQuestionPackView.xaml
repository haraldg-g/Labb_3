<UserControl x:Class="Labb_3.Views.NewQuestionPackView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Labb_3.Views"
             mc:Ignorable="d" 
             d:DesignHeight="200" d:DesignWidth="200">
    
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Labb_3;component/Styles/DialogStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <StackPanel Orientation="Vertical">
            <TextBlock 
                Style="{StaticResource TextBlockStyle}"
                Margin="10,20,10,0"
                Text="Pack Name:" />

            <TextBox 
                Margin="10,0,10,0"
                Text="{Binding Name,
                Mode=TwoWay,
                UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock 
                Style="{StaticResource TextBlockStyle}"
                Text="Difficulty:" />

            <ComboBox 
                Margin="10,0,10,0"
                ItemsSource="{Binding Difficulties}"
                SelectedItem="{Binding Difficulty, 
                Mode=TwoWay}" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock 
                    Style="{StaticResource TextBlockStyle}"
                    Text="Time Limit:" />

                <TextBlock 
                    Grid.Column="1"
                    Style="{StaticResource TextBlockStyle}"
                    Margin="0,10,0,0"
                    Text="{Binding Value, ElementName=TimeLimitSlider}"  />

                <TextBlock 
                    Grid.Column="2"
                    Style="{StaticResource TextBlockStyle}"
                    Text="seconds" />
            </Grid>

            <Slider   
                Margin="10,5,10,0"
                x:Name="TimeLimitSlider"
                Value="{Binding TimeLimitInSeconds, Mode=TwoWay}"
                Minimum="5" Maximum="120"
                IsSnapToTickEnabled="True"
                TickPlacement="BottomRight" TickFrequency="5"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button 
                    Grid.Column="0" 
                    Style="{StaticResource ButtonStyle}"
                    Content="Cancel"
                    Command="{Binding Owner.DataContext.ExitWindowCommand,
                              RelativeSource={RelativeSource AncestorType=Window}}"/>
                <Button 
                    Grid.Column="1"
                    Style="{StaticResource ButtonStyle}"
                    Content="Create"
                    Command="{Binding Owner.DataContext.ConfigurationViewModel.CreateQuestionPackCommand,
                              RelativeSource={RelativeSource AncestorType=Window}}"/>
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>
