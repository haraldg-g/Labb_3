<UserControl x:Class="Labb_3.Views.NewQuestionPackView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Labb_3.Views"
             mc:Ignorable="d" 
             d:DesignHeight="200" d:DesignWidth="200">
    <Grid>
        <StackPanel Orientation="Vertical">
            <TextBlock 
                Margin="10,20,10,0"
                Text="Pack Name:" 
                FontWeight="Bold" >
            </TextBlock>

            <TextBox 
                Margin="10,0,10,0"
                Text="{Binding Name,
                Mode=TwoWay,
                UpdateSourceTrigger=PropertyChanged}">
            </TextBox>

           <TextBlock 
                Margin="10,10,10,0"
                Text="Difficulty:" 
                FontWeight="Bold" >
                </TextBlock>

            <ComboBox 
                Margin="10,0,10,0"
                ItemsSource="{Binding Difficulties}"
                SelectedItem="{Binding Difficulty, 
                Mode=TwoWay}" >
            </ComboBox>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock 
                    Margin="10,10,10,0"
                    Text="Time Limit:" 
                    FontWeight="Bold" >
                </TextBlock>

                <TextBlock 
                    Grid.Column="1"
                    Margin="0,10,5,0"
                    Text="{Binding Value, ElementName=TimeLimitSlider}" 
                    FontWeight="Bold" >
                </TextBlock>

                <TextBlock 
                    Grid.Column="2"
                    Margin="0,10,10,0"
                    Text="seconds" 
                    FontWeight="Bold" >
                </TextBlock>
            </Grid>

            <Slider   
                Margin="10,5,10,0"
                x:Name="TimeLimitSlider"
                Value="{Binding TimeLimitInSeconds, Mode=TwoWay}"
                Minimum="5" Maximum="120"
                IsSnapToTickEnabled="True"
                TickPlacement="BottomRight" TickFrequency="5">
            </Slider>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>


                <Button 
                    Grid.Column="0" 
                    Margin="0,10"
                    Content="Cancel"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="50"/>
                <Button 
                    Grid.Column="1"
                    Margin="0,10"
                    Content="Create"
                    HorizontalAlignment="Center"
                    Width="50"
                    Command="{Binding Owner.DataContext.ConfigurationViewModel.CreateQuestionPackCommand,
                              RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>
