<UserControl x:Class="Labb_3.Views.MenuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Labb_3.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Menu>
            <MenuItem Header="_File">
                <MenuItem Header="_New Question pack" />
                <MenuItem Header="_Select Question pack" />
                <MenuItem Header="_Delete Question pack" />
                <MenuItem Header="_Import Questions" InputGestureText="Ctrl+I"/>
                <MenuItem Header="E_xit" InputGestureText="Alt+F4" />
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="_Add Question" InputGestureText="Insert" 
                          Command="{Binding ConfigurationViewModel.AddQuestionCommand}" Icon="+" />
                <MenuItem Header="_Remove Question" InputGestureText="Delete"
                          Command="{Binding ConfigurationViewModel.RemoveQuestionCommand}" Icon="-"/>
                <MenuItem Header="Pack _Options" InputGestureText="Ctrl+O"
                          Command="{Binding ConfigurationViewModel.OpenPackOptionsCommand}" Icon="☷"/>
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="_Play" InputGestureText="Ctrl+P" 
                          Command="{Binding ChangeCurrentViewCommand}" Icon="x" />
                <MenuItem Header="_Edit" InputGestureText="Ctrl+E"
                          Command="{Binding }" Icon=""/>
                <MenuItem Header="Fullscreen" InputGestureText="Alt+Enter"
                          Command="{Binding }" Icon=""/>
            </MenuItem>
        </Menu>
    </Grid>
</UserControl>
