<UserControl x:Class="Labb_3.Views.ConfigurationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Labb_3.Views"
             mc:Ignorable="d" 
             DataContext="{Binding ConfigurationViewModel}"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="2*" />
        </Grid.ColumnDefinitions>


        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            

            <!-- Övre delen: namn och knappar -->
            <TextBlock 
                Grid.Row="0"
                Text="{Binding ActivePack.Name}" >
            </TextBlock>

            <!-- Nedre delen: separat yta för frågorna -->
            <ListBox Grid.Row="1"
            ItemsSource="{Binding ActivePack.Questions}"
            SelectedItem="{Binding SelectedQuestion}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Query}" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>


        <StackPanel Grid.Column="1">
            <TextBlock Text="Question:" Margin="20,20,0,0" />
            <TextBox Margin="20,2,20,0" Height="100"
                Text="{Binding SelectedQuestion.Query,
                Mode=TwoWay,
                UpdateSourceTrigger=PropertyChanged}" />
            
            <TextBlock Text="Correct Answer:" Margin="20,40,0,0" />
            <TextBox Margin="20,0,20,0" 
                Text="{Binding SelectedQuestion.CorrectAnswer,
                Mode=TwoWay,
                UpdateSourceTrigger=PropertyChanged}" />
            
            <TextBlock Text="First Incorrect Answer:" Margin="20,10 ,0,0" />
            <TextBox Margin="20,0,20,0" 
                Text="{Binding SelectedQuestion.IncorrectAnswers[0],
                Mode=TwoWay,
                UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Text="Second Incorrect Answer:" Margin="20,10 ,0,0" />
            <TextBox Margin="20,0,20,0" 
                Text="{Binding SelectedQuestion.IncorrectAnswers[1],
                Mode=TwoWay,
                UpdateSourceTrigger=PropertyChanged}" />
            
            <TextBlock Text="Third Incorrect Answer:" Margin="20,10 ,0,0" />
            <TextBox Margin="20,0,20,0"
                Text="{Binding SelectedQuestion.IncorrectAnswers[2],
                Mode=TwoWay,
                UpdateSourceTrigger=PropertyChanged}" />

        </StackPanel>
        
    </Grid>
</UserControl>
