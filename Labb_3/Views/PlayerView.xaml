<UserControl x:Class="Labb_3.Views.PlayerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="Labb_3.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Labb_3;component/Styles/PlayerStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        
        <TextBlock Grid.Row="0"
                   Text="{Binding ActiveQuestion.Query}"
                   FontSize="28"
                   FontWeight="Bold"
                   TextAlignment="Center"
                   VerticalAlignment="Top" Margin="0,75,0,0">
        </TextBlock>
        <TextBlock Grid.Row="0"
                   FontSize="16"
                   TextAlignment="Center"
                   VerticalAlignment="Top"
                   Margin="0,130,0,0">
            <TextBlock.Text>
                <MultiBinding StringFormat="Question {0} of {1}">
                    <Binding Path="CurrentQuestionNumber"/>
                    <Binding Path="ActivePack.Questions.Count"/>
                </MultiBinding>
            </TextBlock.Text>
        </TextBlock>
        
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid Grid.Row="0" Grid.Column="0">
                <Button 
                    Style="{StaticResource AnswerButtonStyle}"
                    Content="{Binding ShuffledAnswers[0]}"
                    Command="{Binding AnswerQuestionClickCommand}"
                    CommandParameter="{Binding ShuffledAnswers[0]}" />
                <Image Style="{StaticResource AnswerImageStyleIndex0}" />
            </Grid>
            <Grid Grid.Row="0" Grid.Column="1">
                <Button 
                    Style="{StaticResource AnswerButtonStyle}"
                    Content="{Binding ShuffledAnswers[1]}"
                    Command="{Binding AnswerQuestionClickCommand}"
                    CommandParameter="{Binding ShuffledAnswers[1]}"/>
                <Image Style="{StaticResource AnswerImageStyleIndex1}" />
            </Grid>
            <Grid Grid.Row="1" Grid.Column="0">
                <Button 
                    Style="{StaticResource AnswerButtonStyle}"
                    Content="{Binding ShuffledAnswers[2]}"
                    Command="{Binding AnswerQuestionClickCommand}"
                    CommandParameter="{Binding ShuffledAnswers[2]}"/>
                <Image Style="{StaticResource AnswerImageStyleIndex2}" />
            </Grid>
            <Grid Grid.Row="1" Grid.Column="1">
                <Button 
                    Style="{StaticResource AnswerButtonStyle}"
                    Content="{Binding ShuffledAnswers[3]}"
                    Command="{Binding AnswerQuestionClickCommand}"
                    CommandParameter="{Binding ShuffledAnswers[3]}"/>
                <Image Style="{StaticResource AnswerImageStyleIndex3}" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
