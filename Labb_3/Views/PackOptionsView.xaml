<UserControl x:Class="Labb_3.Views.PackOptionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Labb_3.Views"
             mc:Ignorable="d" 
             DataContext="{Binding ConfigerationViewModel}"
             d:DesignHeight="250" d:DesignWidth="200">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
            Margin="10,40,10,0"
            Text="Pack Name:" 
            FontWeight="Bold" >
        </TextBlock>

        <TextBox Grid.Row="1"
            Margin="10,0,10,0"
            Text="{Binding ActivePack.Name,
            Mode=TwoWay,
            UpdateSourceTrigger=PropertyChanged}">
        </TextBox>

        <TextBlock Grid.Row="2"
            Margin="10,10,10,0"
            Text="Difficulty:" 
            FontWeight="Bold" >
        </TextBlock>

        <ComboBox Grid.Row="3"
            Margin="10,0,10,0"
            ItemsSource="{Binding Difficulties}"
            SelectedItem="{Binding ActivePack.Difficulty, 
            Mode=TwoWay}" >
        </ComboBox>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                Margin="10,10,10,0"
                Text="Time Limit:" 
                FontWeight="Bold" >
            </TextBlock>

            <TextBlock Grid.Column="1"
                Margin="0,10,5,0"
                Text="{Binding Value, ElementName=TimeLimitSlider}" 
                FontWeight="Bold" >
            </TextBlock>

            <TextBlock Grid.Column="2"
                Margin="0,10,10,0"
                Text="seconds" 
                FontWeight="Bold" >
            </TextBlock>
        </Grid>

        <Slider Grid.Row="5"
            Margin="10,5,10,0"
            x:Name="TimeLimitSlider"
            Value="{Binding ActivePack.TimeLimitInSeconds, Mode=TwoWay}"
            Minimum="5" Maximum="120"
            IsSnapToTickEnabled="True"
            TickPlacement="BottomRight" TickFrequency="5">
        </Slider>
    </Grid>
</UserControl>
