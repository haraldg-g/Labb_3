<UserControl x:Class="Labb_3.Views.ConfigurationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
             xmlns:local="clr-namespace:Labb_3.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Labb_3;component/Styles/ConfigurationStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="2*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Grid.Row="0"
                           FontSize="12"
                           Margin="10,5,0,5"
                           FontWeight="Bold"
                           Text="{Binding ActivePack.Name}" />

                <Button Grid.Column="1"
                        Content="{fa:Icon Sliders}"
                        Style="{StaticResource ButtonStyle}"
                        Command="{Binding OpenPackOptionsCommand}" />

                <Button Grid.Column="2"
                        Content="{fa:Icon Plus}"
                        Style="{StaticResource ButtonStyle}"
                        Command="{Binding AddQuestionCommand}" />

                <Button Grid.Column="3"
                        Content="{fa:Icon Minus}"
                        Style="{StaticResource ButtonStyle}"
                        Command="{Binding RemoveQuestionCommand}" />
            </Grid>

            <ListBox Grid.Row="1"
                     ItemsSource="{Binding ActivePack.Questions}"
                     SelectedItem="{Binding SelectedQuestion}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Query}" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <StackPanel Grid.Column="1"
                    Style="{StaticResource EditQuestionPanel}">
            <TextBlock Text="Question:" Style="{StaticResource TextBlockStyle}" />
            <TextBox Style="{StaticResource TextBoxStyle}" Height="100"
                Text="{Binding SelectedQuestion.Query,
                Mode=TwoWay,
                UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Text="Correct Answer:" Style="{StaticResource TextBlockStyle}" />
            <TextBox Style="{StaticResource TextBoxStyle}" 
                Text="{Binding SelectedQuestion.CorrectAnswer,
                Mode=TwoWay,
                UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Text="First Incorrect Answer:" Style="{StaticResource TextBlockStyle}" />
            <TextBox Style="{StaticResource TextBoxStyle}"
                Text="{Binding SelectedQuestion.IncorrectAnswers[0],
                Mode=TwoWay,
                UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Text="Second Incorrect Answer:" Style="{StaticResource TextBlockStyle}" />
            <TextBox Style="{StaticResource TextBoxStyle}"
                Text="{Binding SelectedQuestion.IncorrectAnswers[1],
                Mode=TwoWay,
                UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Text="Third Incorrect Answer:" Style="{StaticResource TextBlockStyle}" />
            <TextBox Style="{StaticResource TextBoxStyle}"
                Text="{Binding SelectedQuestion.IncorrectAnswers[2],
                Mode=TwoWay,
                UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>
        <StackPanel 
            Grid.Column="1"
            Style="{StaticResource CreatePackToContinuePanel}"
            VerticalAlignment="Center"
            HorizontalAlignment="Center"
            Margin="20">

            <TextBlock Text="Ready to create your quiz?"
               FontSize="22"
               FontWeight="SemiBold"
               TextAlignment="Center"/>

            <TextBlock Text="Select or create a question pack to get started."
               FontSize="14"
               TextAlignment="Center"
               Margin="0,10,0,0"/>
        </StackPanel>
    </Grid>
</UserControl>
